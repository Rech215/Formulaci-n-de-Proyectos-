# Copia este archivo como .env y ajusta los valores para tu entorno.

# URL base del backend Node.js.
# En un dispositivo Android físico por USB usa la IP LAN de tu PC,
# nunca localhost ni 127.0.0.1.
# Emulador Android: http://10.0.2.2:3000/api
# Simulador iOS:    http://127.0.0.1:3000/api
API_URL=http://192.168.1.100:3000/api

# true  -> MockEduGuiaRepository (sin backend)
# false -> ApiEduGuiaRepository (backend Node.js real)
USE_MOCKS=false

# Tiempo máximo de espera para las llamadas HTTP (segundos).
API_TIMEOUT_SECONDS=60
